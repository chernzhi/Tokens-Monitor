{
  // 这是 ai-monitor 唯一需要用户理解和修改的配置文件。
  // 配置文件使用 JSONC 风格：// 开头的是说明注释，ai-monitor 和 VS Code 扩展都会自动忽略。
  // 复制为 config.json 后使用；安装向导生成的正式配置默认位于 %APPDATA%/ai-monitor/config.json。
  // server_url: Token 上报服务地址，客户端会向这里发送心跳和用量记录。
  "server_url": "https://your-server.com:59889",
  // user_name: 员工姓名，用于后台和大屏展示。
  "user_name": "姓名",
  // user_id: 员工唯一标识，建议填写登录邮箱或工号；为空时会按本机账号生成匿名 ID。
  "user_id": "your-id@company.com",
  // department: 部门名称，用于统计分组；可留空。
  "department": "部门",
  // port: 本机 MITM HTTP 代理监听端口，默认 18090；端口被占用时程序可能自动顺延。
  "port": 18090,
  // gateway_port: 可选 API Gateway 端口。大于 0 时该端口只提供 /v1/* 与 /vendor/* 反向代理，不做 HTTPS MITM。
  "gateway_port": 0,
  // upstream_proxy: ai-monitor 访问外网 AI 服务时使用的上游代理。支持 http://、https://、socks5://；没有本地代理可留空。
  "upstream_proxy": "http://127.0.0.1:8089",
  // report_proxy: 上报到 server_url 时使用的代理策略：auto 或空=自动判断，direct=直连，upstream=走 upstream_proxy，也可填写具体代理 URL。
  "report_proxy": "",
  // install_system_proxy: 为 true 时安装会写入 Windows 系统 PAC/代理，让浏览器、Visual Studio 等自动经过监控；默认 false 更保守。
  "install_system_proxy": false,
  // install_ide_proxy: 为 true 时安装会写入 VS Code/Cursor 等 IDE 的 http.proxy 设置；通常保持 false，避免与系统代理重复。
  "install_ide_proxy": false,
  // report_opaque_traffic: 为 true 时，对 gRPC/Protobuf 等无法解析 usage 的响应按可见内容估算 token 并上报；非官方计费口径。
  "report_opaque_traffic": true,
  // mitm_cursor: 为 true 时尝试解密 Cursor 流量；如 Cursor 因证书钉扎断连，可改为 false 透传。
  "mitm_cursor": true,
  // chain_existing_pac: 为 true 时保留并串联用户原有企业 PAC；建议保持 true，避免丢失公司内网代理策略。
  "chain_existing_pac": true,
  // strict_policy_check: 为 true 时检测到公司策略级代理会拒绝全局安装，避免覆盖管理员策略；建议保持 true。
  "strict_policy_check": true,
  // monitor_hosts: 完整精确监控域名表。键是主机名，值是供应商标签；可直接增删改，删除后该精确域名不再 MITM。
  "monitor_hosts": {
    "api.openai.com": "openai",
    "chatgpt.com": "openai-codex",
    "www.chatgpt.com": "openai-codex",
    "ab.chatgpt.com": "chatgpt",
    "chat.openai.com": "chatgpt",
